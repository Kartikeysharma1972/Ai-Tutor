# App
APP_NAME=Matchy
ENV=development
DEBUG=true

# Security
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Dev (default): SQLite. Prod: postgresql+psycopg2://user:pass@host:5432/matchy
DATABASE_URL=sqlite:///./matchy.db

# Commission (percent taken from each party)
COMMISSION_RATE_CLIENT=8.0
COMMISSION_RATE_DEVELOPER=5.0
